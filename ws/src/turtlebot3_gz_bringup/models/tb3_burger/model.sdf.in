<?xml version="1.0" ?>
<!--
  TurtleBot3 Burger para Gazebo Fortress — PLANTILLA multirrobot.
  El launch sustituye estos marcadores para cada robot:
    @NS@        espacio de nombres / nombre del modelo (p. ej. tb3_0)
    @MESHES@    ruta absoluta a las mallas de turtlebot3_description
  Convención de frames idéntica a la de los robots reales con namespace:
    tb3_0/odom -> tb3_0/base_footprint -> tb3_0/base_link -> tb3_0/base_scan ...
-->
<sdf version="1.7">
  <model name="@NS@">

    <!-- Links sin masa real: se les da una inercia mínima (si no, Gazebo asume 1 kg) -->
    <link name="base_footprint">
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
    </link>

    <link name="base_link">
      <pose>-0.032 0 0.010 0 0 0</pose>
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.825</mass>
        <inertia><ixx>0.007</ixx><iyy>0.007</iyy><izz>0.006</izz></inertia>
      </inertial>
      <visual name="base_visual">
        <geometry><mesh><uri>file://@MESHES@/bases/burger_base.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <collision name="base_collision">
        <pose>0 0 0.070 0 0 0</pose>
        <geometry><box><size>0.140 0.140 0.140</size></box></geometry>
      </collision>
    </link>

    <!-- IMU -->
    <link name="imu_link">
      <pose>-0.032 0 0.078 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <sensor name="tb3_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/model/@NS@/imu</topic>
        <ignition_frame_id>@NS@/imu_link</ignition_frame_id>
      </sensor>
    </link>

    <!-- LiDAR LDS-01: 360 muestras, 0.12–3.5 m, 5 Hz -->
    <link name="base_scan">
      <pose>-0.032 0 0.182 0 0 0</pose>
      <inertial><mass>0.114</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
      <visual name="lidar_visual">
        <geometry><mesh><uri>file://@MESHES@/sensors/lds.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="lidar_collision">
        <pose>0.015 0 -0.0065 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.0315</length></cylinder></geometry>
      </collision>
      <sensor name="hls_lfcd_lds" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>5</update_rate>
        <topic>/model/@NS@/scan</topic>
        <ignition_frame_id>@NS@/base_scan</ignition_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.28319</max_angle>
            </horizontal>
          </scan>
          <range><min>0.120</min><max>3.5</max><resolution>0.015</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
      </sensor>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.08 0.033 -1.5708 0 0</pose>
      <inertial>
        <mass>0.0285</mass>
        <inertia><ixx>1.11e-5</ixx><iyy>1.11e-5</iyy><izz>2.07e-5</izz></inertia>
      </inertial>
      <visual name="wheel_left_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><mesh><uri>file://@MESHES@/wheels/left_tire.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="wheel_left_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="wheel_right_link">
      <pose>0 -0.08 0.033 -1.5708 0 0</pose>
      <inertial>
        <mass>0.0285</mass>
        <inertia><ixx>1.11e-5</ixx><iyy>1.11e-5</iyy><izz>2.07e-5</izz></inertia>
      </inertial>
      <visual name="wheel_right_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><mesh><uri>file://@MESHES@/wheels/right_tire.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="wheel_right_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- Rueda loca: esfera sin fricción -->
    <link name="caster_back_link">
      <pose>-0.081 0 0.005 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia></inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.005</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="base_joint" type="fixed"><parent>base_footprint</parent><child>base_link</child></joint>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <joint name="scan_joint" type="fixed"><parent>base_link</parent><child>base_scan</child></joint>
    <joint name="caster_back_joint" type="fixed"><parent>base_link</parent><child>caster_back_link</child></joint>

    <!-- Las ruedas giran sobre su eje z local (el link está rotado -90º en x) -->
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Tracción diferencial. Tópicos Gazebo por defecto (probado el curso pasado):
         /model/@NS@/cmd_vel, /model/@NS@/odometry, /model/@NS@/tf -->
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.22</max_linear_velocity>
      <max_angular_velocity>2.84</max_angular_velocity>
      <frame_id>@NS@/odom</frame_id>
      <child_frame_id>@NS@/base_footprint</child_frame_id>
    </plugin>

    <!-- Estado de las ruedas -> robot_state_publisher -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>

    <!-- Posición real (ground truth) en el marco del mundo: solo existe en simulación.
         Útil para comparar con la odometría o como "sistema de captura de movimiento". -->
    <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>@NS@/base_footprint_gt</robot_base_frame>
      <odom_topic>/model/@NS@/ground_truth</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
