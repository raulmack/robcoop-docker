<?xml version="1.0" ?>
<!-- Arena 4x4 m con obstáculos cilíndricos (similar a la del laboratorio) -->
<sdf version="1.7">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistemas del mundo: al declarar alguno hay que declararlos todos.
         Sensors es imprescindible para el LiDAR (gpu_lidar) e Imu para la IMU.
         El motor de render lo fija la opción render-engine de 'ign gazebo' (ogre en WSL). -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"/>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
      <shadows>false</shadows>   <!-- sombras: caras en WSL (D3D12 + ogre1) -->
    </scene>

    <!-- Luz y suelo definidos aquí (sin depender de Gazebo Fuel / Internet) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arena de 4 x 4 m centrada en el origen (paredes de 30 cm, detectables por el LiDAR) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.05 0.05 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.05 0.05 0.30</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.05 0.05 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.05 0.05 0.30</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>2.0 0 0.15 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.05 0.05 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.05 0.05 0.30</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.0 0 0.15 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.05 0.05 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.05 0.05 0.30</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstáculos / objetivos cilíndricos -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.0 1.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_2">
      <static>true</static>
      <pose>-1.0 1.2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_3">
      <static>true</static>
      <pose>1.2 -1.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_4">
      <static>true</static>
      <pose>-1.1 -1.1 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
