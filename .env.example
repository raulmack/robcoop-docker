# Copia este fichero como .env  (cp .env.example .env)

# Plataforma: WSL (Windows)  ->  compose.yaml:compose.wsl.yaml
#             Linux nativo   ->  compose.yaml:compose.linux.yaml
COMPOSE_FILE=compose.yaml:compose.wsl.yaml

# UID/GID de tu usuario en WSL (comando: id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Imagen publicada (se descarga con ./robcoop.sh pull). Para construirla en local:
# ROBCOOP_IMAGE=robcoop:humble  y  ./robcoop.sh build
ROBCOOP_IMAGE=ghcr.io/raulmack/robcoop:humble

# ROS 2 — cada grupo/conjunto de robots usa su propio dominio
ROS_DOMAIN_ID=30
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
TURTLEBOT3_MODEL=burger
LDS_MODEL=LDS-01

# GPU (WSL): NVIDIA, Intel o AMD
GPU_ADAPTER=NVIDIA

# Gazebo en WSL: la GPU vía D3D12 da OpenGL 4.2 y ogre2 necesita 4.3.
#  - Por defecto (GPU):   ROBCOOP_RENDER_ENGINE=ogre   LIBGL_ALWAYS_SOFTWARE=0
#  - Alternativa (CPU):   ROBCOOP_RENDER_ENGINE=       LIBGL_ALWAYS_SOFTWARE=1
#    (ogre2 con mejor aspecto, pero renderizado por CPU: más lento)
ROBCOOP_RENDER_ENGINE=ogre
LIBGL_ALWAYS_SOFTWARE=0

# Solo para el perfil 'zenoh' (Windows 10): un "-e tcp/IP:7447" por robot.
# ZENOH_VERSION debe ser la misma que la del puente instalado en los robots.
ZENOH_VERSION=latest
ZENOH_ARGS=-e tcp/192.168.50.101:7447 -e tcp/192.168.50.102:7447
